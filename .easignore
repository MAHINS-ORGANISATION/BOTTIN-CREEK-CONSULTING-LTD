# Exclude IDE state, sockets, logs, and local diagnostics from EAS upload tarballs.

# IDE / editor
.vscode/
**/.vscode/**
.cursor/
**/.cursor/**
.idea/
**/.idea/**
.fleet/
*.code-workspace
*.iml

# Sockets & local IPC (Cursor / VS Code remote / dev servers)
**/*.sock
**/vscode-ipc-*
**/.cursor-*
**/cursor-*.sock

# Logs & diagnostics (may reference host, user, or device)
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.metro-health-check*
firebase-debug.log
firestore-debug.log

# Profiling / heap / traces
*.hprof
*.trace
*.cpuprofile

# Build outputs & caches (EAS workers regenerate as needed)
dist/
web-build/
.expo/
coverage/
tmp/
temp/
.turbo/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Nested git metadata (EAS normally uses a clean export)
.git/

# Local native trees (EAS runs prebuild)
android/
ios/

# Local env & secrets
.env
.env.*
!.env.example
keystore.properties
**/keystore.properties

# Xcode user state
**/xcuserdata/
**/*.xcuserstate
