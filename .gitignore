# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
# Goal: keep device diagnostics, IDE state, and machine-specific paths out of version control.

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Typegen (regenerated by Expo)
expo-env.d.ts

# Native (generated by prebuild / EAS; do not commit local android/ios)
/ios
/android
.kotlin/

# IDE / editor — machine metadata, sockets, workspace state
.vscode/
.idea/
.cursor/
**/.cursor/**
**/.vscode/**
.fleet/
*.code-workspace
*.iml
**/*.sock
**/vscode-ipc-*
**/.cursor-*
**/cursor-*.sock

# Logs & debug / diagnostic output (may reference paths, hosts, or devices)
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.metro-health-check*
firebase-debug.log
firestore-debug.log

# Profiling / heap / traces (can embed host or session metadata)
*.hprof
*.trace
*.cpuprofile

# Keys & signing (never commit — do not push to GitHub)
*.orig.*
*.jks
*.jks.zip
**/*jks*.zip
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
keystore.properties
**/keystore.properties

# macOS / Windows
.DS_Store
Thumbs.db
Desktop.ini

# Local env (may contain tokens or machine-specific URLs)
.env
.env*.local
!.env.example

# TypeScript
*.tsbuildinfo

app-example

# EAS local credentials (if used)
credentials.json
credentials/

# Xcode user state (if native project ever present locally)
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/

# Fastlane local reports
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Editor backups
*~
*.swp
*.swo
